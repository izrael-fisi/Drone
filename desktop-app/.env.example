# Copy to .env and fill in. Vite reads these at dev-server start / build time.
VITE_SUPABASE_URL=https://<project>.supabase.co
VITE_SUPABASE_ANON_KEY=<supabase publishable/anon key>
VITE_PROXIGO_API_URL=https://proxigo.us
# Dev builds only: comma-separated product entitlement keys to preview.
# VITE_PLATFORM_PRODUCTS=macula_vps,airspace_weather
