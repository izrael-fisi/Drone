# Copy to config/pi/vision-nav.env and edit on the Raspberry Pi if needed.

# Learned Pi shadow runtime. The service does not publish PX4 external vision.
# Leave these commented to use the script defaults under your current $HOME.
# Uncomment and edit if you want service-specific overrides.
# Current default storage is the onboard microSD via $HOME paths. If you later
# mount a USB SSD, point bundle/output paths at that mount.
# VISION_NAV_MAP_RELEASE=/home/pi/drone-data/map_releases/active/map_release.json
# VISION_NAV_MODEL_RELEASE=/home/pi/drone-data/model_releases/pi5_crossview_nav_v1/model_release.json
# VISION_NAV_CALIBRATION_ID=down-camera-v1
# VISION_NAV_INFERENCE_PROVIDER=onnxruntime_cpu
# VISION_NAV_OUTPUT_DIR=/home/pi/DroneTransfer/outgoing/neural-shadow
# VISION_NAV_STATUS_UDP_TARGET=255.255.255.255:17660
# VISION_NAV_MODEL_ARTIFACT_ROOT=/home/pi/drone-data/model_releases/pi5_crossview_nav_v1
# One-frame model smoke test. Do not set this for the long-running camera service.
# VISION_NAV_SHADOW_FRAME=/home/pi/test-frame.jpg
# To sample the Pi-attached camera in shadow mode: picamera2, auto, or rpicam_still.
# Picamera2 preserves the sensor timestamps expected by field-training capture.
# VISION_NAV_CAMERA_BACKEND=picamera2
# Shadow evidence limits, not flight-qualified thresholds.
# VISION_NAV_MAX_TEMPORAL_FRAME_GAP_MS=1500
# VISION_NAV_MAX_FRAME_AGE_MS=1000
# Live shadow capture runs independently of inference; pending capacity is one.
# VISION_NAV_SHADOW_CAPTURE_INTERVAL_S=0.5
# VISION_NAV_CALIBRATION_FILE=/home/pi/drone-data/calibration/down_camera.yaml
# VISION_NAV_CAMERA_WIDTH=1456
# VISION_NAV_CAMERA_HEIGHT=1088
# VISION_NAV_CAMERA_TIMEOUT_MS=1000
# Required only when a live camera temporal student contract is enabled. The
# shadow runtime reads ATTITUDE only and does not send MAVLink commands.
# VISION_NAV_MAVLINK_ENDPOINT=serial:/dev/ttyACM0:921600
# Expected Pixhawk sender; not the Pi's own MAVLink source IDs.
# VISION_NAV_MAVLINK_TARGET_SYSTEM=1
# VISION_NAV_MAVLINK_TARGET_COMPONENT=1
# VISION_NAV_ATTITUDE_STALE_AFTER_MS=500
# Independent shadow status reporting; warning only, not model cancellation.
# VISION_NAV_HEARTBEAT_INTERVAL_S=0.5
# VISION_NAV_INFERENCE_WARNING_MS=2000
# Opt-in concurrent runtime measurements (not an automatic flight acceptance).
# VISION_NAV_RECORD_RUNTIME_METRICS=1
# VISION_NAV_METRICS_INTERVAL_S=1
# VISION_NAV_METRICS_MAX_SAMPLES=3600
# VISION_NAV_MAX_ATTITUDE_FRAME_DELTA_MS=50

# Training-capture session. These values are consumed by
# scripts/pi/record_training_capture.sh and do not command or arm PX4.
# The calibration YAML must be a measured calibration, not the placeholder
# checked into this repository.
# VISION_NAV_TRAINING_CAPTURE_ROOT=/home/pi/drone-data/captures
# VISION_NAV_CALIBRATION_FILE=/home/pi/Drone/config/camera/down_camera.yaml
# VISION_NAV_CAMERA_TO_BODY_FILE=/home/pi/Drone/config/camera/camera_to_body.yaml
# First field captures use a model-independent ReferenceMapRelease. The legacy
# VISION_NAV_MAP_RELEASE_ID remains valid for later MapRelease v2 captures.
# VISION_NAV_REFERENCE_MAP=/home/pi/drone-data/reference-maps/field-map/reference_map.json
# VISION_NAV_REFERENCE_MAP_ID=field-map@0.1.0
# VISION_NAV_MAP_REFERENCE_KIND=reference_map_release
# VISION_NAV_MAVLINK_ENDPOINT=serial:/dev/ttyACM0:921600
# VISION_NAV_CAPTURE_FRAMES=120
# VISION_NAV_CAPTURE_INTERVAL_S=0.5
# VISION_NAV_REQUIRE_MAVLINK_ATTITUDE=1
# VISION_NAV_REQUIRE_SENSOR_TIMESTAMPS=1
# The first supervised field dataset also requires offline-only GNSS labels.
# This never enables GNSS as a flight-runtime dependency. Set to 0 only for a
# camera/MAVLink bench capture that will not enter a DatasetRelease.
# VISION_NAV_REQUIRE_OFFLINE_GNSS_REFERENCE=1
# VISION_NAV_MIN_OFFLINE_GNSS_FIX_TYPE=3
# VISION_NAV_MAX_OFFLINE_GNSS_HORIZONTAL_ACCURACY_M=10
# VISION_NAV_MAX_OFFLINE_GNSS_FRAME_AGE_MS=500
# Field training also records a short MAVLink TIMESYNC audit before camera
# capture. This is timing evidence only; it never changes PX4 state.
# VISION_NAV_REQUIRE_MAVLINK_TIMESYNC=1
# VISION_NAV_TIMESYNC_SAMPLE_COUNT=8
# VISION_NAV_MAX_TIMESYNC_ROUND_TRIP_MS=50
# VISION_NAV_MAX_ATTITUDE_FRAME_DELTA_MS=50
# VISION_NAV_CAPTURE_SITE_NAME=field-site
# VISION_NAV_CAPTURE_OPERATOR=operator
# VISION_NAV_CAPTURE_CONDITION=nominal-daylight

# Manual-focus/global-shutter camera bench. Aim at a high-texture target before
# calibration or training capture; the default accepts no quality warnings.
# VISION_NAV_CAMERA_BENCH_FRAMES=8
# VISION_NAV_CAMERA_BENCH_DELAY_S=0.25
# VISION_NAV_CAMERA_SHARPNESS_MIN=60
# VISION_NAV_CAMERA_ENTROPY_MIN=3.5
# VISION_NAV_CAMERA_EDGE_DENSITY_MIN=8000
# VISION_NAV_CAMERA_SATURATION_MAX=0.15
# VISION_NAV_CAMERA_MAX_WARNING_FRACTION=0

# Prop-off MAVLink bench evidence. The recorder sends bounded TIMESYNC requests
# for timing evidence only; it never sends a PX4 command, parameter, or
# external-position message.
# VISION_NAV_MAVLINK_BENCH_DURATION_S=15
# VISION_NAV_MIN_ATTITUDE_RATE_HZ=20
# VISION_NAV_MAX_ATTITUDE_GAP_MS=150

# Combined prop-off decision. This is an explicit physical safety attestation;
# software cannot verify whether propellers were actually removed.
# VISION_NAV_PROP_OFF_CONFIRMED=1
# VISION_NAV_REQUIRE_TRAINING_CAPTURE_INPUTS=0

# Research-computer split defaults. These are not consumed during flight.
# VISION_NAV_VALIDATION_FRACTION=0.2
# VISION_NAV_SPLIT_SEED=20260830

# Companion Edge API. The desktop app probes this HTTP service for device,
# runtime, and MAVLink connectivity status. Keep service control disabled unless
# the Pi is on a trusted private network.
# VISION_NAV_API_HOST=0.0.0.0
# VISION_NAV_API_PORT=5000
# VISION_NAV_API_MAVLINK_ENDPOINT=serial:/dev/ttyACM0:921600
# VISION_NAV_API_SERIAL_BAUD=921600
# VISION_NAV_API_ALLOW_SERVICE_CONTROL=0

# Legacy replay/log helper defaults; not the learned flight runtime.
# VISION_NAV_TERRAIN_REPLAY_LOG=/home/pi/DroneTransfer/outgoing/terrain-match/terrain_matches.jsonl
# VISION_NAV_REPLAY_OUTPUT_DIR=/home/pi/DroneTransfer/outgoing/terrain-replay
# VISION_NAV_RUNTIME_LOG=/home/pi/DroneTransfer/outgoing/terrain-match/terrain_matches.jsonl
# VISION_NAV_REPLAY_LOG=/home/pi/DroneTransfer/outgoing/terrain-replay/terrain_replay_matches.jsonl

# Docker container paths.
VISION_NAV_LOG_DIR=/logs
VISION_NAV_MAP_DIR=/maps
VISION_NAV_CONFIG_DIR=/config
VISION_NAV_CAMERA_CONFIG=/config/camera/down_camera.yaml
VISION_NAV_EXTRINSICS_CONFIG=/config/camera/camera_to_body.yaml
